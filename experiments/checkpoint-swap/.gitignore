# Everything rebuildable is regenerated by bootstrap_mmdet.sh and run.sh and is
# never committed: the venvs, the downloaded checkpoints, the exported ONNX,
# and the ~1 GB of COCO images.
# results/ IS committed - the whole point is that the numbers can be re-checked
# without re-running the sweep.
.venv/
.venv310/
__pycache__/
*.onnx
*.pth
work_dir/
